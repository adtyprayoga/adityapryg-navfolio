---
interface Props {
  labels: Record<string, string>;
}
const { labels } = Astro.props;
---

<dialog
  class="book-reader"
  data-book-reader
  data-labels={JSON.stringify(labels)}
  aria-labelledby="book-reader-title"
  data-pagefind-ignore
>
  <div class="book-reader-shell">
    <header class="book-reader-toolbar">
      <button type="button" class="book-reader-back" data-reader-close
        >← <span>{labels.backToProjects}</span></button
      >
      <h2 id="book-reader-title" data-reader-title>{labels.loading}</h2>
      <button type="button" class="book-reader-close" data-reader-close aria-label={labels.close}
        >×</button
      >
    </header>
    <p class="book-reader-status" data-reader-status role="status" aria-live="polite"></p>
    <div class="book-reader-content" data-reader-spread hidden>
      <aside class="book-reader-sidebar" aria-label={labels.chapters}>
        <div class="book-reader-cover" data-reader-cover aria-hidden="true"></div>
        <p class="book-reader-meta" data-reader-meta></p>
        <div class="book-reader-links" data-reader-links></div>
        <p class="book-reader-contents-label">{labels.chapters}</p>
        <nav data-reader-chapter-buttons aria-label={labels.chapters}></nav>
      </aside>
      <div class="book-reader-page" data-reader-page tabindex="-1"></div>
    </div>
    <div class="book-reader-error" data-reader-error hidden>
      <p data-reader-error-text></p>
      <button type="button" data-reader-retry>{labels.retry}</button>
      <a data-reader-open-page href="/projects/">{labels.openPage}</a>
    </div>
    <nav class="book-reader-nav" data-reader-nav hidden aria-label={labels.chapters}>
      <button type="button" data-reader-previous>{labels.previous}</button>
      <label class="book-reader-select-label"
        >{labels.chapters}<select data-reader-chapters aria-label={labels.chapters}></select></label
      >
      <span data-reader-progress aria-live="polite"></span>
      <button type="button" data-reader-next>{labels.next}</button>
    </nav>
  </div>
</dialog>

<script>
  import { initBookReader } from './reader';
  initBookReader();
  document.addEventListener('astro:page-load', initBookReader);
</script>
