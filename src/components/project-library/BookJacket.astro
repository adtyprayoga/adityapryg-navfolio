---
interface Props {
  id: string;
  title: string;
  year: number;
  kicker: string;
}
const { id, title, year, kicker } = Astro.props;
const hash = Array.from(id).reduce((sum, letter) => sum + letter.charCodeAt(0), 0);
const colors = ['sage', 'slate', 'clay', 'plum', 'ochre', 'ink'];
const featured = id === 'weekly-journal-bot';
const color = featured ? 'clay' : colors[hash % colors.length];
const motif = featured ? 0 : 1 + (hash % 4);
---

<span class={`library-cover library-cover--${color}`} data-book-cover>
  <span class="library-cover-kicker">{kicker}</span>
  <span class="library-cover-title">{title}</span>
  <svg class="library-cover-art" viewBox="0 0 200 140" fill="none" aria-hidden="true">
    {
      motif === 0 && (
        <>
          <circle cx="103" cy="70" r="62" fill="currentColor" opacity=".12" />
          <path d="M35 30h99v64H70l-22 17V94H35z" fill="currentColor" opacity=".9" />
          <path d="M60 49h49M60 62h35M60 75h43" stroke="var(--cover)" stroke-width="4" />
          <path
            d="M100 81h69v41h-12l-14 12v-12h-43z"
            fill="var(--cover)"
            stroke="currentColor"
            stroke-width="3"
          />
          <path d="m120 101 9 9 20-21" stroke="currentColor" stroke-width="4" />
          <path d="M155 22v18m-9-9h18M23 111v12m-6-6h12" stroke="currentColor" stroke-width="2" />
        </>
      )
    }
    {
      motif === 1 && (
        <>
          <circle cx="100" cy="70" r="55" fill="currentColor" opacity=".15" />
          <circle cx="100" cy="70" r="29" stroke="currentColor" stroke-width="2" />
          <ellipse
            cx="100"
            cy="70"
            rx="86"
            ry="27"
            transform="rotate(-32 100 70)"
            stroke="currentColor"
            stroke-width="2"
          />
          <ellipse
            cx="100"
            cy="70"
            rx="86"
            ry="27"
            transform="rotate(32 100 70)"
            stroke="currentColor"
          />
          <circle cx="159" cy="35" r="8" fill="currentColor" />
          <circle cx="42" cy="108" r="4" fill="currentColor" />
          <path d="M100 26v88M56 70h88" stroke="currentColor" opacity=".5" />
        </>
      )
    }
    {
      motif === 2 && (
        <>
          <path
            d="M32 122V65a34 34 0 0 1 68 0v57M100 122V35a34 34 0 0 1 68 0v87"
            stroke="currentColor"
            stroke-width="2"
          />
          <path
            d="M45 122V65a21 21 0 0 1 42 0v57M113 122V35a21 21 0 0 1 42 0v87"
            fill="currentColor"
            opacity=".25"
          />
          <circle cx="134" cy="85" r="21" fill="currentColor" />
          <path d="M20 123h160M66 90v32M49 106h34" stroke="currentColor" stroke-width="2" />
        </>
      )
    }
    {
      motif === 3 && (
        <>
          <path d="M25 105 100 15l75 90H25Z" fill="currentColor" opacity=".2" />
          <path
            d="m25 105 75-90 75 90H25Zm16 0 59-69 59 69M58 105l42-48 42 48M76 105l24-27 24 27M22 118h156M45 131h110"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle cx="153" cy="31" r="15" fill="currentColor" />
        </>
      )
    }
    {
      motif === 4 && (
        <>
          <path
            d="M100 126V35M100 83C56 85 31 65 30 28c42 0 68 16 70 55ZM100 107c43 0 65-19 68-52-40 0-65 17-68 52Z"
            stroke="currentColor"
            stroke-width="2"
          />
          <path d="M100 83C56 85 31 65 30 28c42 0 68 16 70 55Z" fill="currentColor" opacity=".2" />
          <path
            d="m100 83-49-37m49 61 47-34M100 35c-19-10-23-25-16-34 15 3 23 14 16 34Z"
            stroke="currentColor"
            stroke-width="2"
          />
          <circle cx="151" cy="25" r="12" fill="currentColor" />
          <path d="M59 127h82" stroke="currentColor" stroke-width="2" />
        </>
      )
    }
  </svg>
  <span class="library-cover-footer"><span>{year}</span><span aria-hidden="true">AP</span></span>
</span>
