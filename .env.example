# Copy to .env and adjust. Used by docker-compose.yml.

# Public URL of the deployed site. Baked into canonical links, sitemap and RSS
# at build time. Empty falls back to config.site.url in src/config/site.toml.
SITE_URL=

# Sub-path when the site is not served from the domain root, e.g. /blog
SITE_BASE=

# Host port for the production container.
HTTP_PORT=8080

# Host port for the dev container (docker compose --profile dev up dev).
DEV_PORT=4321

# 1 skips the CJK font subset build step. Safe for an English/Indonesian site.
SKIP_FONT_SUBSET=0
