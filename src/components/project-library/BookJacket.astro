---
import { coverDesign } from './cover-design';
interface Props {
  id: string;
  title: string;
  year: number;
  kicker: string;
}
const { id, title, year, kicker } = Astro.props;
const { motif, palette } = coverDesign(id);
---

<span class={`library-cover library-cover--${palette}`} data-book-cover>
  <span class="library-cover-kicker">{kicker}</span>
  <span class="library-cover-title">{title}</span>
  <svg class="library-cover-art" viewBox="0 0 180 140" fill="none" aria-hidden="true">
    {
      motif === 'document' && (
        <>
          <rect x="43" y="16" width="88" height="110" rx="5" fill="currentColor" opacity=".22" />
          <path
            d="M56 41h62M56 56h49M56 71h62M56 86h38"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="round"
          />
          <circle cx="126" cy="99" r="24" fill="currentColor" opacity=".8" />
          <path
            d="m115 99 8 8 15-18"
            stroke="var(--cover)"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </>
      )
    }
    {
      motif === 'pages' && (
        <>
          <path
            d="M23 29c25-8 47-6 67 3v86c-20-9-42-11-67-3V29ZM90 32c20-9 42-11 67-3v86c-25-8-47-6-67 3V32Z"
            fill="currentColor"
            opacity=".2"
            stroke="currentColor"
            stroke-width="3"
            stroke-linejoin="round"
          />
          <path
            d="M90 32v86M37 49c15-3 27-2 38 2M37 65c15-3 27-2 38 2M105 51c11-4 23-5 38-2M105 67c11-4 23-5 38-2"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />
        </>
      )
    }
    {
      motif === 'contour' && (
        <>
          <path
            d="M20 93c4-35 33-67 67-67 31 0 58 25 69 55 7 20-2 43-26 47-16 3-27-8-40-9-15-1-27 13-44 8-18-5-28-18-26-34Z"
            fill="currentColor"
            opacity=".13"
          />
          <path
            d="M29 92c4-29 28-55 58-55 28 0 52 23 60 47 6 18-4 34-20 37-14 2-22-8-37-9-17-2-27 12-42 5-12-5-21-13-19-25Zm18 1c2-19 20-36 42-36 19 0 35 15 39 31 3 10-3 17-12 18-11 2-16-8-27-7-12 0-17 8-28 4-8-2-15-5-14-10Zm22 0c2-9 10-16 21-16 8 0 16 7 17 14"
            stroke="currentColor"
            stroke-width="2"
          />
        </>
      )
    }
    {
      motif === 'diagram' && (
        <>
          <path
            d="M38 34h52v33H38zM105 20h40v42h-40zM93 90h60v36H93zM28 96h44v30H28z"
            fill="currentColor"
            opacity=".2"
            stroke="currentColor"
            stroke-width="2"
          />
          <path d="M90 50h15M125 62v28M72 111h21M58 67v29" stroke="currentColor" stroke-width="3" />
          <circle cx="90" cy="50" r="4" fill="currentColor" />
          <circle cx="125" cy="78" r="4" fill="currentColor" />
          <circle cx="58" cy="82" r="4" fill="currentColor" />
        </>
      )
    }
  </svg>
  <span class="library-cover-footer"><span>{year}</span><span aria-hidden="true">AP</span></span>
</span>
